# ─── Variables públicas del frontend (Vercel → Environment Variables) ───
# Sí, llevan "NEXT_PUBLIC_" porque las usa el navegador. NO son secretos:
# solo son la URL del webhook y la URL de la tienda PrestaShop.

# Webhook de n8n que recibe los mensajes del chat
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://paneln8n.transformaconia.com/webhook/031ab1e6-d64e-41f0-b03e-f5c0681a6491

# URL base de la tienda PrestaShop (para abrir producto y carrito)
NEXT_PUBLIC_PS_BASE=https://esgas.nodoflow.com

# ─── IMPORTANTE: NO añadir aquí la API key de PrestaShop ───
# La API key de PrestaShop va EXCLUSIVAMENTE en n8n → Credentials.
# Ver docs/N8N_SETUP.md para la guía completa.
